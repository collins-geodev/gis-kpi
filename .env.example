# ---------------------------------------------------------------------------
# GIS KPI Dashboard — environment variables (PLACEHOLDERS ONLY, never commit real values)
# Copy to `.env.local` for local dev. Set the same keys in Vercel + Convex dashboards
# per environment (development / preview / production). Secrets live only in the
# platform dashboards, never in git.
# ---------------------------------------------------------------------------

# --- Convex (frontend needs the public deployment URL) ---------------------
# Provided automatically by `npx convex dev`; copy the printed value here.
NEXT_PUBLIC_CONVEX_URL="https://YOUR-DEPLOYMENT.convex.cloud"

# Convex deploy key (CI / Vercel build only — NOT needed for local dev).
# CONVEX_DEPLOY_KEY="prod:YOUR-DEPLOY-KEY"

# --- Convex Auth -----------------------------------------------------------
# Set these with `npx @convex-dev/auth` (writes SITE_URL + JWT keys to Convex env).
# SITE_URL is the canonical app origin used for auth callbacks.
SITE_URL="http://localhost:3000"
# JWT_PRIVATE_KEY / JWKS are generated by the auth setup CLI and stored in the
# Convex deployment environment — do not place private keys in this file.

# --- AI report generation (Vercel AI Gateway by default) -------------------
# Route model access through the Vercel AI Gateway unless another provider is
# explicitly configured. The model ID is configuration, never hard-coded.
# Verify the current available model list before setting this.
AI_GATEWAY_API_KEY="vck_YOUR_VERCEL_AI_GATEWAY_KEY"
AI_REPORT_MODEL="openai/gpt-4o-mini"   # example id; confirm against the live gateway model list
AI_REPORT_PROMPT_VERSION="v1"
# If NOT using the gateway, configure a direct provider instead (one of):
# OPENAI_API_KEY="sk-..."

# --- Email notifications (Convex env — set with `npx convex env set`) ------
# KPI updates email every System Admin + the person who logged the update,
# using a branded template. Without RESEND_API_KEY, emails are skipped but
# in-app notifications still fire.
# RESEND_API_KEY="re_..."            # from resend.com (secret — Convex env only)
# EMAIL_FROM="GIS KPI Dashboard <kpi@yourdomain.com>"  # verified sender; defaults to Resend onboarding
# DASHBOARD_URL="https://gis-kpi.vercel.app"           # CTA link base in emails

# --- File / evidence limits ------------------------------------------------
MAX_EVIDENCE_FILE_MB="25"
# Optional malware-scanning webhook (set on Convex: npx convex env set ...).
# Leave blank to disable — files then stay scanStatus "pending" and nothing is
# blocked. When set, each uploaded evidence file's bytes are POSTed to this URL
# (headers: Content-Type = file mime, X-Filename, Authorization: Bearer <token>
# if the token is set). The scanner must answer 200 with JSON:
#   {"verdict": "clean" | "flagged", "detail"?: "signature name"}
# "flagged" blocks downloads and alerts every System Admin; any other response
# is audited as malware_scan_error and the file stays "pending".
MALWARE_SCAN_WEBHOOK_URL=""
MALWARE_SCAN_WEBHOOK_TOKEN=""

# --- Feature flags ---------------------------------------------------------
# Whether the org has explicitly enabled 80→100 normalization display.
NEXT_PUBLIC_ENABLE_NORMALIZATION="false"
